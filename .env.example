# Copy to .env and fill in. The gateway refuses to start without a real
# MCPG_SIGNING_SECRET; there is no fallback default.

# Required. At least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
MCPG_SIGNING_SECRET=

# Optional, shown with their defaults.
MCPG_POLICY_FILE=policy.yaml
MCPG_KEYS_FILE=keys.json
MCPG_AUDIT_DB=audit.db

# off | redact | block
MCPG_SCANNER_MODE=redact

MCPG_RATE_LIMIT_RPM=60
MCPG_RATE_LIMIT_BURST=10
MCPG_UPSTREAM_TIMEOUT_SECONDS=10
